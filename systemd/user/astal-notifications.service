[Unit]
Description=Astal Notifications
PartOf=graphical-session.target
Requires=graphical-session.target
After=wireplumber.service hyprpaper.service wayland-session@hyprland.desktop.target app.slice
Before=astal-bar.service

[Service]
Type=simple
ExecStart=/home/francisco/.config/astal-widgets/start.fish notifications
Slice=session.slice
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target

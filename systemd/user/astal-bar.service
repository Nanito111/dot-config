[Unit]
Description=Astal Bar
PartOf=graphical-session.target
Requires=graphical-session.target
After=wireplumber.service hyprpaper.service wayland-session@hyprland.desktop.target app.slice
# ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/home/francisco/.config/astal-widgets/start.fish bar
Slice=session.slice
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target

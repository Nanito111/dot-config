<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1747707710836458-1</unique-id>
	<command>uwsm app -- foot -D %f</command>
	<description>Open a terminal in the selected directory or file</description>
	<range>1</range>
	<patterns>*</patterns>
	<directories/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as Wallpaper</name>
	<submenu></submenu>
	<unique-id>1747709438731220-1</unique-id>
	<command>change-wallpaper wallpaper %f</command>
	<description>Set selected image as wallpaper</description>
	<range>1</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as Lockscreen</name>
	<submenu></submenu>
	<unique-id>1763593108929851-1</unique-id>
	<command>change-wallpaper lockscreen %f</command>
	<description>Set selected image as lockscreen</description>
	<range>1</range>
	<patterns>*</patterns>
	<image-files/>
</action>
<action>
	<icon>emblem-symbolic-link</icon>
	<name>Open Real Location</name>
	<submenu></submenu>
	<unique-id>1763594885771670-2</unique-id>
	<command>thunar &quot;$(readlink -f %f)&quot;</command>
	<description>Open the real location of a file or directory. This is useful for following symlinks</description>
	<range>1</range>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
</actions>

            }
        },
        "font": {
            "family": {
                "material": "Material Symbols Rounded",
                "mono": "Bitcount Grid Single",
                "sans": "Bitcount Prop Single"
            },
            "size": {
                "scale": 1.1420537897310514
            }
        },
        "padding": {
            "scale": 1.0707627118644067
        },

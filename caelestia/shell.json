{
    "appearance": {
        "anim": {
            "durations": {
                "scale": 0.48
            }
        },
        "font": {
            "body": {
                "family": "Patrick Hand"
            },
            "clock": "Cherry Bomb One",
            "headline": {
                "family": "Cherry Bomb One"
            },
            "icon": {
                "family": "Material Symbols Rounded"
            },
            "label": {
                "family": "Patrick Hand"
            },
            "mono": {
                "family": "Noto Mono"
            },
            "scale": 1,
            "title": {
                "family": "Cherry Bomb One"
            },
            "workspaces": "Rubik"
        },
        "padding": {
            "scale": 1.07
        },
        "rounding": {
            "scale": 0.5
        },
        "spacing": {
            "scale": 0.37
        },
        "transparency": {
            "base": 0.95,
            "enabled": true
        }
    },
    "background": {
        "desktopClock": {
            "background": {
                "blur": true,
                "enabled": false,
                "opacity": 0.28
            },
            "enabled": true,
            "invertColors": false,
            "position": "middle-left",
            "shadow": {
                "blur": 2,
                "enabled": true,
                "opacity": 0.3
            }
        },
        "enabled": true,
        "visualiser": {
            "enabled": false
        },
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": true,
            "showOnHover": false
        },
        "clock": {
            "background": true,
            "showDate": true,
            "showIcon": false,
            "showSeconds": false
        },
        "dragThreshold": 100,
        "entries": [
            {
                "enabled": true,
                "id": "logo"
            },
            {
                "enabled": true,
                "id": "workspaces"
            },
            {
                "enabled": true,
                "id": "spacer"
            },
            {
                "enabled": true,
                "id": "activeWindow"
            },
            {
                "enabled": true,
                "id": "spacer"
            },
            {
                "enabled": true,
                "id": "tray"
            },
            {
                "enabled": true,
                "id": "clock"
            },
            {
                "enabled": true,
                "id": "statusIcons"
            },
            {
                "enabled": true,
                "id": "power"
            }
        ],
        "excludedScreens": [
            "DVI-D-1"
        ],
        "persistent": true,
        "popouts": {
            "activeWindow": false,
            "statusIcons": true,
            "tray": true
        },
        "scrollActions": {
            "brightness": false,
            "volume": true
        },
        "showOnHover": true,
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "microphone"
            },
            {
                "enabled": true,
                "id": "kbLayout"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": false,
                "id": "battery"
            }
        ],
        "tray": {
            "background": true,
            "compact": false,
            "recolour": true
        },
        "workspaces": {
            "activeIndicator": true,
            "activeTrail": true,
            "occupiedBg": true,
            "perMonitor": true,
            "showUnoccupied": true,
            "showWindows": false,
            "shown": 4
        }
    },
    "border": {
        "rounding": 10,
        "thickness": 12
    },
    "dashboard": {
        "resourceUpdateInterval": 1000
    },
    "general": {
        "apps": {
            "audio": [
                "org.gnome.Decibels"
            ],
            "explorer": [
                "thunar"
            ],
            "playback": [
                "clapper"
            ],
            "terminal": [
                "foot"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "enabled": true,
                    "idleAction": "lock",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 600
                },
                {
                    "enabled": true,
                    "idleAction": "dpms off",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 615
                },
                {
                    "enabled": true,
                    "idleAction": [
                        "systemctl",
                        "suspend-then-hibernate"
                    ],
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 600
                }
            ]
        }
    },
    "launcher": {
        "actionPrefix": "/",
        "enableDangerousActions": true,
        "favouriteApps": [
            "thunar",
            "waterfox",
            "foot",
            "obsidian",
            "helium"
        ],
        "hiddenApps": [
            "thunar-settings",
            "xfce4-about",
            "thunar-bulk-rename",
            "electron34",
            "electron36",
            "electron37",
            "footclient",
            "foot-server",
            "org.freedesktop.IBus.Setup",
            "jconsole-java-openjdk",
            "jshell-java-openjdk",
            "panel-preferences",
            "qv4l2",
            "qvidcap",
            "ukmm"
        ],
        "maxWallpapers": 12,
        "showOnHover": true,
        "useFuzzy": {
            "apps": true,
            "wallpapers": true
        },
        "vimKeybinds": true
    },
    "notifs": {
        "defaultExpireTimeout": 3000
    },
    "paths": {
        "wallpaperDir": "~/Pictures/wallpapers"
    },
    "services": {
        "clockFormat": "TwentyFourHour",
        "dataUnits": "Decimal",
        "defaultPlayer": "BrowserWorks waterfox",
        "sensorUnits": "Celsius",
        "weatherUnits": "Celsius"
    },
    "utilities": {
        "toasts": {
            "capsLockChanged": true,
            "fullscreen": "important"
        }
    }
}

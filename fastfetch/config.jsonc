{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/francisco/Pictures/mini-link.jpg",
    "preserveAspectRatio": true,
    "width": 30,
    "type": "sixel",
    "padding": {
      "top": 7,
      "right": 1
    },
    "position": "left"
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "red",
      "format": "{2}"
    },
    {
      "type": "os",
      "key": "├",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "├",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "├󰏖",
      "keyColor": "red"
    },
    {
      "type": "shell",
      "key": "└",
      "keyColor": "blink_red"
    },
    "break",
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "light_magenta"
    },
    {
      "type": "lm",
      "key": "├󱅞",
      "keyColor": "light_magenta"
    },
    {
      "type": "theme",
      "key": "├󰉼",
      "keyColor": "light_magenta"
    },
    {
      "type": "icons",
      "key": "├",
      "keyColor": "light_magenta"
    },
    {
      "type": "cursor",
      "key": "├󰇀",
      "keyColor": "light_magenta"
    },
    {
      "type": "font",
      "key": "├",
      "keyColor": "light_magenta"
    },
    {
      "type": "terminal",
      "key": "├",
      "keyColor": "light_magenta"
    },
    "break",
    {
      "type": "host",
      "key": " PC",
      "keyColor": "light_yellow"
    },
    {
      "type": "cpu",
      "key": "├󰻠",
      "keyColor": "light_yellow"
    },
    {
      "type": "gpu",
      "key": "├󰍛",
      "keyColor": "light_yellow"
    },
    {
      "type": "disk",
      "key": "├",
      "keyColor": "light_yellow"
    },
    {
      "type": "memory",
      "key": "├",
      "keyColor": "light_yellow"
    },
    {
      "type": "swap",
      "key": "├",
      "keyColor": "light_yellow"
    },
    {
      "type": "display",
      "key": "├󰍹",
      "keyColor": "light_yellow"
    },
    {
      "type": "localip",
      "key": "├󰩠",
      "keyColor": "light_yellow"
    },
    {
      "type": "bluetooth",
      "key": "├󰂯",
      "keyColor": "light_yellow"
    },
    {
      "type": "uptime",
      "key": "└󰅐",
      "keyColor": "light_yellow"
    },
    "break",
    {
      "type": "sound",
      "key": "󰗅 SOUND",
      "keyColor": "light_cyan"
    },
    {
      "type": "player",
      "key": "├󰥠",
      "keyColor": "light_cyan"
    },
    {
      "type": "media",
      "key": "└󰝚",
      "keyColor": "light_cyan"
    },
    "break",
    "colors"
  ]
}
